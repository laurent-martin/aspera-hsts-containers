FROM rockylinux:9

ARG RPM_FILE
ARG S6_VERSION=3.2.3.0

# Install runtime dependencies (procps-ng: ps/pgrep used by the RPM scriptlets;
# python3, used by syslog-bridge, and curl, used by the healthcheck, are in the base image)
RUN dnf install -y \
      openssh-clients \
      openssh-server \
      procps-ng \
      shadow-utils \
      sudo \
      xz \
    && dnf clean all

# Install s6-overlay (includes init + service supervisor), for the build platform's architecture
RUN for pkg in noarch "$(uname -m)"; do \
      curl -fsSL "https://github.com/just-containers/s6-overlay/releases/download/v${S6_VERSION}/s6-overlay-${pkg}.tar.xz" \
        | tar -C / -Jxp || exit 1; \
    done

# Create aspera system user/group
RUN groupadd -r aspadmins \
 && useradd -r -g aspadmins -s /sbin/nologin -d /opt/aspera asperadaemon

# Install the RPM
COPY ${RPM_FILE} /tmp/aspera.rpm
RUN rpm -ivh /tmp/aspera.rpm && rm /tmp/aspera.rpm

# Remove the TLS key pair generated by the RPM: it would be shared by every container
# built from this image. A per-deployment one is generated at first start.
RUN rm -f /opt/aspera/etc/aspera_server_cert.pem /opt/aspera/etc/aspera_server_key.pem /opt/aspera/etc/server.csr

# Ensure runtime dirs exist with correct ownership
RUN mkdir -p \
      /opt/aspera/var/run/aspera \
      /opt/aspera/var/log \
      /opt/aspera/etc/asperacentral \
 && chown -R asperadaemon:aspadmins /opt/aspera/var /opt/aspera/etc

# Save copies of /opt/aspera/etc and /opt/aspera/var as defaults
# (volume mounts shadow them at runtime; init populates empty volumes from these)
RUN cp -a /opt/aspera/etc /opt/aspera/etc.default \
 && cp -a /opt/aspera/var /opt/aspera/var.default

# Create transfer user — aspshell as login shell
RUN useradd -m -s /bin/aspshell xfer \
 && mkdir -p /home/xfer/.ssh \
 && chmod 700 /home/xfer/.ssh \
 && chown xfer:xfer /home/xfer/.ssh

RUN mkdir -p /var/run/sshd

# sshd config
COPY config/ssh/sshd_config /etc/ssh/sshd_config

# s6 service definitions
COPY rootfs/ /

ENV PATH="/opt/aspera/bin:/opt/aspera/sbin:${PATH}"
# Stop the container if init fails; no time limit for init (first start generates keys)
ENV S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0

# Ports: Node API (HTTPS), SSH, FASP UDP
EXPOSE 9092 22 33001/udp

ENTRYPOINT ["/init"]
