# Copy of this file: cp .env.example .env
# Never commit .env to git.

# Docker registry (e.g. registry.example.com/aspera)
REGISTRY=localhost

# Image tag — defaults to the RPM version (set by rake)
TAG=4.4.8.2592

# asperanoded API credentials (required)
# Password: 16-92 ASCII characters, with at least 2 lowercase, 2 uppercase and 2 digits
NODE_USER=nodeuser
NODE_PASS=

# Exposed ports (host side)
NODE_PORT=9092
ASCP_SSH_PORT=33001
FASP_UDP_PORT=33001

# SSH public key(s) for the xfer user (newline-separated if multiple)
XFER_AUTHORIZED_KEYS=

# Docroot of the xfer user (inside the container)
XFER_DOCROOT=/home/xfer

# License: either the content of a license file...
ASPERA_LICENSE=
# ...or an ALEE entitlement
ASPERA_CUSTOMER_ID=
ASPERA_ENTITLEMENT_ID=
